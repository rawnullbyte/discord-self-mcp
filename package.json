{
  "name": "@rawnullbyte/discord-self-mcp",
  "version": "0.1.0",
  "description": "MCP server for a Discord user account: channels, messages, roles, moderation, invites and more",
  "license": "MIT",
  "type": "module",
  "bin": {
    "discord-self-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "discord",
    "selfbot",
    "model-context-protocol",
    "opencode"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.mjs",
    "smoke": "node test/smoke.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@discord-selfbot/core": "^14.1.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawnullbyte/discord-self-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/rawnullbyte/discord-self-mcp/issues"
  },
  "homepage": "https://github.com/rawnullbyte/discord-self-mcp#readme"
}
